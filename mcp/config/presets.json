{
  "version": 3,
  "presets": {
    "azure-web-research": {
      "transport": "stdio",
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec python3 \"$HOME/GitHub/agents/mcp/azure_web_research.py\" serve"
      ],
      "tool_timeout_sec": 300,
      "repos": "all"
    },
    "openaiDeveloperDocs": {
      "transport": "http",
      "url": "https://developers.openai.com/mcp",
      "repos": [
        "~/GitHub/agents",
        "~/GitHub/frontier-lab-intelligence"
      ]
    },
    "cloudflare-api": {
      "transport": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "repos": [
        "~/GitHub/platform-ops"
      ]
    },
    "cloudflare-docs": {
      "transport": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "repos": [
        "~/GitHub/platform-ops"
      ]
    },
    "figma": {
      "transport": "http",
      "url": "http://127.0.0.1:3845/mcp",
      "repos": [
        "~/GitHub/aipodcasting"
      ]
    }
  }
}
