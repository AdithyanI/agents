{
  "managed_hooks": [
    {
      "command": "python3 \"$HOME/GitHub/agents/hooks/scripts/session_start.py\" --runtime {runtime}",
      "enabled": true,
      "event": "SessionStart",
      "id": "repo-session-start",
      "matchers": {
        "codex": "startup|clear|compact"
      },
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex"
      ],
      "scope": "repo",
      "timeout": 5
    },
    {
      "command": "python3 \"$HOME/GitHub/agents/hooks/scripts/stop.py\" --runtime {runtime}",
      "enabled": true,
      "event": "Stop",
      "id": "global-stop",
      "runtimes": [
        "codex",
        "claude"
      ],
      "scope": "global",
      "timeout": 900
    },
    {
      "command": "python3 \"$HOME/GitHub/agents/hooks/scripts/claude_tool_use.py\" --runtime {runtime}",
      "enabled": true,
      "event": "PostToolUse",
      "id": "claude-turn-attribution",
      "matchers": {
        "claude": "Edit|MultiEdit|Write|NotebookEdit|Bash"
      },
      "runtimes": [
        "claude"
      ],
      "scope": "global",
      "timeout": 10
    }
  ],
  "version": 1
}
